# TrustRAG Accounting demo environment.
# Copy to /etc/trustrag-accounting/trustrag-accounting.env and edit locally.
# Do not commit real secrets or server-specific values.

APP_ENV=production-demo
LOG_LEVEL=INFO

# Deterministic template mode is the default and needs no provider secret.
LLM_ANSWER_MODE=template
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE=memory
RERANKER_PROVIDER=mock

# Ingestion currently writes the document and chunk stores to the repository's
# data/ directory. Their locations are CLI arguments, not runtime env settings.
TRUSTRAG_REVIEW_STORE_PATH=/opt/trustrag-accounting/app/data/review_queue.jsonl
TRUSTRAG_REVIEW_ACTIONS_PATH=/opt/trustrag-accounting/app/data/review_actions.jsonl
TRUSTRAG_EVAL_HISTORY_DIR=/opt/trustrag-accounting/app/data/eval_history
TRUSTRAG_PROVIDER_BENCHMARK_HISTORY_DIR=/opt/trustrag-accounting/app/data/provider_benchmark_history

# Optional real provider settings. Leave empty for deterministic template mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
