# TrustRAG environment configuration (template)
# Copy to .env and fill in your local values. NEVER commit the real .env.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- LLM answer generation (Phase 8B) ----
# The real LLM answer generator is OPTIONAL and OFF by default. With
# LLM_ANSWER_MODE=template (default) the deterministic template generator
# runs and no API key / network is needed — this is what CI and the test
# suite always use. Set LLM_ANSWER_MODE=llm to enable provider generation;
# every generated answer is then validated against a citation contract and
# falls back to the template answer on any failure or invalid citation.
#
# NEVER commit a real .env. Leave the *_API_KEY lines empty here.
LLM_ANSWER_MODE=template
# Supported: mock (default, deterministic, offline) | openai_compatible |
# anthropic_compatible
LLM_PROVIDER=mock
# OpenAI-compatible provider (LLM_PROVIDER=openai_compatible). Points at any
# /chat/completions endpoint (OpenAI, vLLM, Together, Groq, LM Studio, …).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Anthropic-compatible provider (LLM_PROVIDER=anthropic_compatible). Uses the
# Messages API. The model is read from env — no Claude version is hard-coded.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Embedding Provider ----
# Supported: mock (default). Real providers land in Phase 3D.
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=64
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Retrieval (Phase 3B) ----
# When true (default), the vector branch joins keyword + BM25 in the
# HybridRetriever fusion. Set to false to fall back to Phase 3A
# two-way retrieval.
RETRIEVAL_ENABLE_VECTOR=true

# ---- Vector Store ----
# Supported: memory (default) | qdrant
# Qdrant requires installing the optional extra:
#   pip install 'trust-rag[qdrant]'
# Tests never read this — they instantiate InMemoryVectorStore directly.
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=trustrag_chunks

# ---- Reranker (Phase 3C) ----
# Supported: mock (default) | none
# Real adapters (bge / cohere) are placeholders until Phase 3E.
# Set to "none" to disable the post-hybrid rerank pass entirely.
RERANKER_PROVIDER=mock
RERANKER_TOP_N=12
RERANKER_WEIGHT=0.15

# ---- Relational Store (future, not required for local demo or CI) ----
# DATABASE_URL=postgresql+psycopg://trust_rag:trust_rag@localhost:5432/trust_rag

# ---- Cache (future, not required for local demo or CI) ----
# REDIS_URL=redis://localhost:6379/0

# ---- TrustRAG behavior knobs ----
TRUST_RAG_CONFIDENCE_THRESHOLD=0.6
TRUST_RAG_ENABLE_COUNTER_RETRIEVAL=true
TRUST_RAG_ENABLE_TEMPORAL_CHECK=true
TRUST_RAG_ENABLE_SAFETY_CHECK=true

# ---- Local tracing (Phase 4B) ----
# When true, the retrieval runnable wraps invokes in a span-recording
# shim that writes start / end / error events into the process-wide
# LocalTraceCollector. The optional GET / DELETE /v1/debug/traces
# endpoint exposes the ring buffer for local debugging.
TRUSTRAG_TRACE_ENABLED=false
# Only "local" is wired in Phase 4B. Any other value falls back to
# disabled with a log warning rather than failing the boot.
TRUSTRAG_TRACE_MODE=local
TRUSTRAG_TRACE_MAX_EVENTS=100
# When false (default), trace summaries never include full document
# content — only chunk ids, scores, retrieval strategy, and counts.
TRUSTRAG_TRACE_INCLUDE_CONTENT=false

# ---- Remote LangSmith tracing (intentionally NOT enabled) ----
# Phase 4B ships local tracing only. The variables below are documented
# so a misconfigured machine cannot accidentally upload trace data to
# a remote service: by default both stay empty / false. If you want to
# turn them on for your own experiments, do so in a private .env that
# is never committed.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=
LANGCHAIN_API_KEY=

# ---- Human review handoff (Phase 5B) ----
# When true (default), the LangGraph workflow routes through a
# ``human_review_handoff`` node for tax / invoice / conflict /
# low-confidence cases and appends a content-safe ReviewCheckpoint
# to the local JSONL queue. Unsafe refusal cases NEVER enter the
# queue — the policy explicitly excludes them.
TRUSTRAG_HUMAN_REVIEW_ENABLED=true
TRUSTRAG_REVIEW_STORE_PATH=data/review_queue.jsonl
# When false (default), checkpoints store evidence summaries
# (chunk_id, score, retrieval_strategy, …) but never full document
# content. Set to true ONLY for local debugging.
TRUSTRAG_REVIEW_INCLUDE_CONTENT=false
TRUSTRAG_REVIEW_MAX_ENTRIES=1000
# Below this confidence, queries route into the human review queue
# even when no specific hard gate fires.
TRUSTRAG_REVIEW_CONFIDENCE_THRESHOLD=0.6

# ---- Reviewer actions (Phase 7B) ----
# Append-only JSONL log of approve / reject / request_changes /
# rewrite_note / resolve / reopen events applied by a local reviewer
# via the dashboard. The file lives under ``data/`` and is gitignored.
# This is a *local demo* audit trail, not a production authorization
# system — there is no authentication and no per-reviewer permission
# check.
TRUSTRAG_REVIEW_ACTIONS_PATH=data/review_actions.jsonl
TRUSTRAG_REVIEW_ACTIONS_MAX_ENTRIES=2000

# ---- Eval artifacts and history (Phase 7D) ----
# The dashboard reads these local files only. It never runs evals,
# writes snapshots, or pulls remote artifacts from the API layer.
TRUSTRAG_EVAL_RESULTS_PATH=data/eval_results.json
TRUSTRAG_EVAL_REPORT_PATH=data/eval_report.md
TRUSTRAG_EVAL_HISTORY_DIR=data/eval_history
TRUSTRAG_EVAL_HISTORY_LIMIT=50

# ---- Provider benchmark dashboard (Phase 8D) ----
# The dashboard reads these local benchmark artifacts only. It never runs a
# benchmark, calls a real provider, requires a key, or writes files. Generate
# artifacts manually with: bash scripts/run_provider_benchmark.sh mock
TRUSTRAG_PROVIDER_BENCHMARK_RESULTS_PATH=data/provider_benchmark_results.json
TRUSTRAG_PROVIDER_BENCHMARK_REPORT_PATH=data/provider_benchmark_report.md
TRUSTRAG_PROVIDER_BENCHMARK_DIR=data/provider_benchmarks
TRUSTRAG_PROVIDER_BENCHMARK_LIMIT=20

# ---- Provider benchmark trend history (Phase 8E) ----
# The dashboard reads these local compact summary snapshots only. It never runs
# a benchmark, calls a real provider, requires a key, or writes files. Archive a
# snapshot manually with: bash scripts/archive_provider_benchmark_snapshot.sh
TRUSTRAG_PROVIDER_BENCHMARK_HISTORY_DIR=data/provider_benchmark_history
TRUSTRAG_PROVIDER_BENCHMARK_HISTORY_LIMIT=50
