# TrustRAG environment configuration (template)
# Copy to .env and fill in your local values. NEVER commit the real .env.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- LLM Provider (not used in MVP; mock provider is the default) ----
# Supported (planned): mock | openai | anthropic | bedrock | azure
LLM_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Embedding Provider (planned) ----
EMBEDDING_PROVIDER=mock
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector Store (planned for Phase 1+) ----
# VECTOR_STORE=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Relational Store (planned for Phase 1+) ----
# DATABASE_URL=postgresql+psycopg://trust_rag:trust_rag@localhost:5432/trust_rag

# ---- Cache (planned) ----
# REDIS_URL=redis://localhost:6379/0

# ---- TrustRAG behavior knobs ----
TRUST_RAG_CONFIDENCE_THRESHOLD=0.6
TRUST_RAG_ENABLE_COUNTER_RETRIEVAL=true
TRUST_RAG_ENABLE_TEMPORAL_CHECK=true
TRUST_RAG_ENABLE_SAFETY_CHECK=true
